server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_vary on;
  gzip_types text/css application/json application/javascript text/javascript;

  # The manifest and the remote entry keep their names across releases. If browsers cached them,
  # the shell would keep loading the previous addon version after an upgrade.
  location = /mf-manifest.json {
    add_header Cache-Control "no-cache" always;
  }

  location = /remoteEntry.js {
    add_header Cache-Control "no-cache" always;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Optional backend of this addon. The dashboard proxies /addon-assets/oakestra-mcp/api/... here
  # (useAddonApi() in the UI) with the /addon-assets/oakestra-mcp prefix removed, so the backend sees
  # /api/... and this block strips /api as well. Set API_UPSTREAM to the backend's scheme, host and
  # port only, e.g. http://oakestra-mcp-api:8000: with a variable, any path in proxy_pass (even a
  # trailing slash) replaces the whole request URI. Without it the path answers 404, so a UI-only
  # addon needs no change.
  location /api/ {
    # The backend may start after this container, so the upstream is resolved per request.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream "${API_UPSTREAM}";
    if ($api_upstream = "") {
      return 404;
    }
    # Matches the MCP server's own request limit (maxMCPBody), so a large SLA is refused by the
    # backend with a readable error instead of an nginx 413 page. The dashboard's proxy in front
    # of this one allows up to 32m.
    client_max_body_size 8m;
    # A variable in proxy_pass disables the automatic prefix stripping, so do it by hand.
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Server-sent events: without these nginx buffers the stream until it ends. The shell's own
    # nginx honours X-Accel-Buffering too. The read timeout only has to exceed the backend's
    # keep-alive ping interval (15s is typical); the shell's proxy allows 60s of silence.
    proxy_buffering off;
    add_header X-Accel-Buffering no always;
    proxy_read_timeout 300s;

    add_header Cache-Control "no-store" always;
  }

  location / {
    try_files $uri =404;
  }
}
